            padding: 0 !important;
            border: 0 !important;
            overflow: hidden !important;
            clip: rect(0, 0, 0, 0) !important;
            pointer-events: none !important;
        }
        .custom-select-dropdown {
            position: relative;
            width: 100%;
        }
        .input-group > .custom-select-dropdown {
            flex: 1 1 auto;
            width: 1% !important;
            min-width: 0;
        }
        .input-group > .custom-select-dropdown > .custom-select-btn {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }
        .custom-select-btn {
            cursor: pointer;
            width: 100%;
            max-width: 100%;
            text-align: left;
        }
        .custom-select-btn::after {
            display: none !important;
        }
        .custom-select-menu {
            border-radius: 0.5rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
            width: 100% !important;
            min-width: 100% !important;
            max-width: 100% !important;
        }
        [data-bs-theme="dark"] .custom-select-menu {
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.45);
        }
        button[data-bs-toggle="collapse"][aria-expanded="true"] .bi-chevron-down,
        a[data-bs-toggle="collapse"][aria-expanded="true"] .bi-chevron-down {
            transform: rotate(180deg);
        }

        @@media (min-width: 992px) {
            .semester-dropdown-btn {
                min-width: 220px;
            }
        }

        @@media (max-width: 991.98px) {
            #sidebar-wrapper {
                transform: translateX(-100%);
                transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                width: 280px;
                max-width: 85vw;
                z-index: 1050;
                box-shadow: none;
            }
            #sidebar-wrapper.show {
                transform: translateX(0);
                box-shadow: 10px 0 30px rgba(0, 0, 0, 0.4);
            }
            #page-content-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                min-width: 0;
                padding-top: 56px; /* Bù đắp chiều cao cho Top Navbar cố định trên Mobile */
            }
            .top-navbar {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                right: 0 !important;
                width: 100% !important;
                z-index: 1030 !important;
                padding: 0.6rem 0.85rem;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            }
            [data-bs-theme="dark"] .top-navbar {
                box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45) !important;
            }
            .semester-dropdown-btn {
                max-width: 155px;
                padding: 0.35rem 0.55rem;
                font-size: 0.8rem;
            }
            .semester-btn-text {
                max-width: 90px;
            }
            .dropdown-menu {
                max-width: calc(100vw - 20px) !important;
            }
            main {
                padding: 0.85rem !important;
            }
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar Navigation -->
        <div id="sidebar-wrapper">
            <div class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div>
                    <div class="fw-bold text-white" style="letter-spacing: -0.01em; font-size: 0.98rem;">KHOA CNTT - CTUET</div>
                    <small class="text-white-50 fw-normal" style="font-size: 0.72rem;">Quản Lý Thực Tập Doanh Nghiệp</small>
                </div>
                <!-- Nút đóng Sidebar trên mobile -->
                <button id="sidebarCloseBtn" class="btn btn-sm btn-link text-white d-lg-none ms-auto p-1 text-decoration-none" type="button" aria-label="Đóng menu">
                    <i class="bi bi-x-lg fs-5 opacity-75"></i>
                </button>
            </div>

            <div class="sidebar-menu">
                @if (User.IsInRole("admin"))
                {
                    <div class="sidebar-heading">Quản trị Khoa</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard Thống kê
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "SinhVien" ? "active" : "")" 
                       asp-area="Admin" asp-controller="SinhVien" asp-action="Index">
                        <i class="bi bi-people"></i> Quản lý Sinh viên & Phân công
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "GiangVien" ? "active" : "")" 
                       asp-area="Admin" asp-controller="GiangVien" asp-action="Index">
                        <i class="bi bi-person-workspace"></i> Quản lý Giảng viên
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "DotThucTap" ? "active" : "")" 
                       asp-area="Admin" asp-controller="DotThucTap" asp-action="Index">
                        <i class="bi bi-calendar3"></i> Cấu hình Đợt thực tập
                    </a>
                }
                else if (User.IsInRole("giang_vien"))
                {
                    <div class="sidebar-heading">Giảng viên Hướng dẫn</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                       asp-area="GiangVien" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard GVHD
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "YeuCau" ? "active" : "")" 
                       asp-area="GiangVien" asp-controller="YeuCau" asp-action="Index">
                        <i class="bi bi-person-plus"></i> Yêu cầu Hướng dẫn
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "SinhVien" ? "active" : "")" 
                       asp-area="GiangVien" asp-controller="SinhVien" asp-action="Index">
                        <i class="bi bi-person-lines-fill"></i> Sinh viên phụ trách & Chấm điểm
                    </a>
                }
                else if (User.IsInRole("sinh_vien"))
                {
                    <div class="sidebar-heading">Sinh viên Thực tập</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Tổng quan tiến độ
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "DangKy" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="DangKy" asp-action="Index">
                        <i class="bi bi-building-check"></i> Đăng ký Nơi thực tập
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "DeCuong" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="DeCuong" asp-action="Index">
                        <i class="bi bi-file-earmark-text"></i> Đề cương kế hoạch
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "DinhKy" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="BaoCao" asp-action="DinhKy">
                        <i class="bi bi-journal-check"></i> Nhật ký định kỳ
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "TongKet" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="BaoCao" asp-action="TongKet">
                        <i class="bi bi-file-earmark-pdf"></i> Nộp báo cáo GK/CK
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "KetQua" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="KetQua" asp-action="Index">
                        <i class="bi bi-award"></i> Kết quả đánh giá
                    </a>
                }
            </div>

            <!-- Chân trang Sidebar (Ảnh 1) -->
            <div class="sidebar-bottom">
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-btn">
                        <i class="bi bi-box-arrow-left"></i>
                        <span>Đăng xuất hệ thống</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Backdrop che mờ khi mở Sidebar trên Mobile -->
        <div id="sidebar-backdrop"></div>

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <!-- Top Navbar -->
            <div class="top-navbar d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <!-- Nút bật menu Hamburger trên Mobile -->
                    <button id="sidebarToggleBtn" class="btn btn-sm border d-lg-none d-flex align-items-center justify-content-center shadow-none" 
                            style="width: 36px; height: 36px;" type="button" aria-label="Mở menu">
                        <i class="bi bi-list fs-4"></i>
                    </button>

                    <div class="fw-bold text-dark d-none d-lg-block" style="font-size: 0.95rem;">
                        <i class="bi bi-mortarboard-fill text-primary me-1"></i> Khoa Công nghệ Thông tin
                        <span class="text-muted fw-normal ms-1">| Thực tập Doanh nghiệp</span>
                    </div>

                    @if (User.IsInRole("admin") && danhSachDot.Any())
                    {
                        <form id="formChangeSemester" method="post" asp-area="Admin" asp-controller="DotThucTap" asp-action="ChonKy" class="d-inline-block m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <input type="hidden" name="dotId" id="selectedDotIdInput" value="@selectedDotId" />
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border dropdown-toggle fw-bold text-primary d-flex align-items-center gap-1.5 semester-dropdown-btn shadow-none" 
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-calendar3 text-primary flex-shrink-0"></i>
                                    <span class="d-none d-sm-inline text-muted fw-semibold">Kỳ:</span>
                                    <span class="semester-btn-text text-truncate" title="@(dotDangChon?.TenDot)">@(dotDangChon?.TenDot ?? "Chọn kỳ thực tập")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-start shadow-sm py-1 semester-dropdown-menu">
                                    <li class="dropdown-header small text-muted">Chọn kỳ thực tập</li>
                                    @foreach (var dot in danhSachDot)
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item d-flex justify-content-between align-items-center py-2 px-3 @(dot.Id == selectedDotId ? "active fw-bold" : "")"
                                                    onclick="document.getElementById('selectedDotIdInput').value='@dot.Id'; document.getElementById('formChangeSemester').submit();">
                                                <span class="text-truncate me-2">@dot.TenDot</span>
                                                @if (dot.TrangThaiKichHoat)
                                                {
                                                    <span class="badge bg-warning text-dark flex-shrink-0" style="font-size: 0.68rem;">★ Hiện tại</span>
                                                }
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </form>
                    }
                    else if (dotDangChon != null)
                    {
                        <div class="badge bg-light text-primary border px-2.5 py-1.5 fs-7 fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i> @dotDangChon.TenDot
                        </div>
                    }
                </div>

                <div class="d-flex align-items-center gap-2.5">
                    <!-- Nút chuyển đổi Giao diện Sáng / Tối (Ảnh 2 & 3) -->
                    <button id="themeToggleBtn" type="button" class="btn btn-sm btn-light border rounded-circle d-flex align-items-center justify-content-center" 
                            style="width: 36px; height: 36px; transition: all 0.2s;" title="Chuyển chế độ Sáng / Tối">
                        <i id="themeToggleIcon" class="bi bi-sun-fill text-warning fs-6"></i>
                    </button>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var role = User.FindFirst(ClaimTypes.Role)?.Value;
                        string badgeClass = role switch {
                            "admin" => "badge-role-admin",
                            "giang_vien" => "badge-role-gv",
                            _ => "badge-role-sv"
                        };
                        string roleName = role switch {
                            "admin" => "Quản trị viên",
                            "giang_vien" => "Giảng viên",
                            _ => "Sinh viên"
                        };

                        <span class="badge @badgeClass px-2.5 py-1.5 rounded-pill fs-7 d-none d-sm-inline-flex align-items-center">
                            <i class="bi bi-shield-check me-1"></i>@roleName
                        </span>

                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" 
                                    type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i>
                                <span class="d-none d-sm-inline">@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li class="dropdown-header d-sm-none text-truncate fw-bold">
                                    <small class="text-muted d-block">Đang đăng nhập:</small>
                                    @User.Identity.Name
                                    <span class="badge @badgeClass ms-1">@roleName</span>
                                </li>
                                <li><hr class="dropdown-divider d-sm-none"></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-sm btn-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                        </a>
                    }
                </div>
            </div>

            <!-- Main Body -->
            <main class="p-2.5 p-sm-3 p-md-4 flex-grow-1">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-white border-top py-3 text-center text-muted small">
                &copy; @DateTime.Now.Year - Đồ án 4: Hệ thống Quản lý Thực tập Tốt nghiệp - C# ASP.NET Core MVC & PostgreSQL
            </footer>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script Quản lý Chế độ Giao diện Dark / Light Mode -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('themeToggleBtn');
            const toggleIcon = document.getElementById('themeToggleIcon');

            function applyTheme(theme) {
                document.documentElement.setAttribute('data-bs-theme', theme);
                localStorage.setItem('theme', theme);

                if (toggleBtn && toggleIcon) {
                    if (theme === 'dark') {
                        toggleIcon.className = 'bi bi-moon-stars-fill text-info fs-6';
                        toggleBtn.className = 'btn btn-sm btn-dark border border-secondary rounded-circle d-flex align-items-center justify-content-center';
                        toggleBtn.setAttribute('title', 'Chuyển sang chế độ Sáng');
                    } else {
                        toggleIcon.className = 'bi bi-sun-fill text-warning fs-6';
                        toggleBtn.className = 'btn btn-sm btn-light border rounded-circle d-flex align-items-center justify-content-center';
                        toggleBtn.setAttribute('title', 'Chuyển sang chế độ Tối');
                    }
                }
            }

            const currentTheme = localStorage.getItem('theme') || 'light';
            applyTheme(currentTheme);

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    const activeTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
                    const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
                    applyTheme(newTheme);
                });
            }

            // Xử lý Mobile Sidebar Offcanvas
            const sidebar = document.getElementById('sidebar-wrapper');
            const backdrop = document.getElementById('sidebar-backdrop');
            const toggleBtnSidebar = document.getElementById('sidebarToggleBtn');
            const closeBtnSidebar = document.getElementById('sidebarCloseBtn');

            function openSidebar() {
                if (sidebar) sidebar.classList.add('show');
                if (backdrop) backdrop.classList.add('show');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                if (sidebar) sidebar.classList.remove('show');
                if (backdrop) backdrop.classList.remove('show');
                document.body.style.overflow = '';
            }

            if (toggleBtnSidebar) toggleBtnSidebar.addEventListener('click', openSidebar);
            if (closeBtnSidebar) closeBtnSidebar.addEventListener('click', closeSidebar);
            if (backdrop) backdrop.addEventListener('click', closeSidebar);

            // Tự động đóng sidebar khi bấm link menu trên mobile
            document.querySelectorAll('.sidebar-menu .nav-link-custom').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (window.innerWidth < 992) {
                        closeSidebar();
                    }
                });
            });

            // Đóng khi nhấn phím Escape
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });

            // Tự động đóng nếu người dùng mở rộng màn hình sang desktop
            window.addEventListener('resize', function () {
                if (window.innerWidth >= 992) {
                    closeSidebar();
                }
            });

            // Khởi tạo Custom Dropdown HTML cho các thẻ <select> dạng form-select (đặc biệt trong bộ lọc)
            // Giúp giao diện mobile đồng bộ, đẹp mắt, không bị lỗi native popup Windows phóng to tràn màn hình
            function initCustomSelects(container) {
                const root = container || document;
                root.querySelectorAll('form select.form-select:not(.no-custom-select):not([multiple])').forEach(function (select) {
                    if (select.dataset.customized === 'true') return;
                    select.dataset.customized = 'true';

                    // Ẩn select gốc một cách an toàn (vẫn hỗ trợ form submit & required validation)
                    select.classList.add('custom-select-native');

                    // Tạo container dropdown bọc ngoài
                    const wrapper = document.createElement('div');
                    wrapper.className = 'dropdown custom-select-dropdown w-100';

                    // Tạo nút bấm giả lập y hệt form-select
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'form-select custom-select-btn d-flex align-items-center justify-content-between ' + 
                        (select.classList.contains('form-select-sm') ? 'form-select-sm ' : '') +
                        (select.classList.contains('form-select-lg') ? 'form-select-lg ' : '');
                    btn.setAttribute('data-bs-toggle', 'dropdown');
                    btn.setAttribute('data-bs-auto-close', 'true');
                    btn.setAttribute('aria-expanded', 'false');

                    const labelSpan = document.createElement('span');
                    labelSpan.className = 'text-truncate me-2';

                    const currentOpt = select.options[select.selectedIndex] || select.options[0];
                    labelSpan.textContent = currentOpt ? currentOpt.text : '';
                    btn.appendChild(labelSpan);

                    // Menu danh sách các lựa chọn
                    const menu = document.createElement('ul');
                    menu.className = 'dropdown-menu w-100 shadow-sm custom-select-menu py-1';
                    menu.style.maxHeight = '260px';
                    menu.style.overflowY = 'auto';

                    function renderOptions() {
                        menu.innerHTML = '';
                        Array.from(select.options).forEach(function (opt, index) {
                            const li = document.createElement('li');
                            const itemBtn = document.createElement('button');
                            itemBtn.type = 'button';
                            itemBtn.className = 'dropdown-item py-2 px-3 d-flex align-items-center justify-content-between ' + 
                                (opt.selected ? 'active fw-bold' : '');
                            
                            const optText = document.createElement('span');
                            optText.className = 'text-truncate';
                            optText.textContent = opt.text;
                            itemBtn.appendChild(optText);

                            if (opt.selected) {
                                const icon = document.createElement('i');
                                icon.className = 'bi bi-check2 ms-2';
                                itemBtn.appendChild(icon);
                            }

                            itemBtn.addEventListener('click', function (e) {
                                e.preventDefault();
                                select.selectedIndex = index;
                                select.value = opt.value;
                                labelSpan.textContent = opt.text;

                                menu.querySelectorAll('.dropdown-item').forEach(function (b, i) {
                                    b.classList.toggle('active', i === index);
                                    b.classList.toggle('fw-bold', i === index);
                                    const ic = b.querySelector('.bi-check2');
                                    if (ic) ic.remove();
                                    if (i === index) {
                                        const newIc = document.createElement('i');
                                        newIc.className = 'bi bi-check2 ms-2';
                                        b.appendChild(newIc);
                                    }
                                });

                                // Kích hoạt sự kiện onchange cho select
                                select.dispatchEvent(new Event('change', { bubbles: true }));
                            });

                            li.appendChild(itemBtn);
                            menu.appendChild(li);
                        });
                    }

                    renderOptions();

                    // Lắng nghe nếu select thay đổi giá trị bằng code JS hoặc reset form
                    select.addEventListener('change', function () {
                        const cur = select.options[select.selectedIndex];
                        if (cur) {
                            labelSpan.textContent = cur.text;
                            menu.querySelectorAll('.dropdown-item').forEach(function (b, i) {
                                b.classList.toggle('active', i === select.selectedIndex);
                                b.classList.toggle('fw-bold', i === select.selectedIndex);
                            });
                        }
                    });

                    // Lắng nghe nếu danh sách option thay đổi động qua MutationObserver
                    const observer = new MutationObserver(function () {
                        renderOptions();
                        const cur = select.options[select.selectedIndex];
                        if (cur) labelSpan.textContent = cur.text;
                    });
                    observer.observe(select, { childList: true });

                    wrapper.appendChild(btn);
                    wrapper.appendChild(menu);
                    select.parentNode.insertBefore(wrapper, select.nextSibling);
                });
            }

            initCustomSelects();

            // Khởi tạo lại nếu có modal hoặc nội dung động nạp sau
            document.addEventListener('shown.bs.modal', function (e) {
                initCustomSelects(e.target);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
