@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject QuanLyThucTap.Models.ThucTapDbContext DbContext
@{
    var danhSachDot = await DbContext.DotThucTaps.OrderByDescending(d => d.Id).ToListAsync();
    long selectedDotId = 0;
    if (Context.Request.Cookies.TryGetValue(QuanLyThucTap.Helpers.SemesterHelper.CookieKey, out var cookieVal) && long.TryParse(cookieVal, out var parsedId))
    {
        selectedDotId = parsedId;
    }
    else
    {
        selectedDotId = danhSachDot.FirstOrDefault(d => d.TrangThaiKichHoat)?.Id ?? danhSachDot.FirstOrDefault()?.Id ?? 0;
    }
    var dotDangChon = danhSachDot.FirstOrDefault(d => d.Id == selectedDotId);
}
