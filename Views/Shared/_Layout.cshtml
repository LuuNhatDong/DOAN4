@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject QuanLyThucTap.Models.ThucTapDbContext DbContext
@{
    var danhSachDot = await DbContext.DotThucTaps.OrderByDescending(d => d.Id).ToListAsync();
    long selectedDotId = 0;
    if (Context.Request.Cookies.TryGetValue(QuanLyThucTap.Helpers.SemesterHelper.CookieKey, out var cookieVal) && long.TryParse(cookieVal, out var parsedId))
    {
        selectedDotId = parsedId;
    }
    else
    {
        selectedDotId = danhSachDot.FirstOrDefault(d => d.TrangThaiKichHoat)?.Id ?? danhSachDot.FirstOrDefault()?.Id ?? 0;
    }
    var dotDangChon = danhSachDot.FirstOrDefault(d => d.Id == selectedDotId);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Thực Tập Doanh Nghiệp - Khoa CNTT</title>
    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --sidebar-width: 260px;
            --primary-color: #2563eb;
        }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        #sidebar-wrapper {
            min-height: 100vh;
            width: var(--sidebar-width);
            background: #ffffff;
            border-right: 1px solid #e2e8f0;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: all 0.3s;
        }
        #page-content-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .sidebar-brand {
            padding: 1.25rem 1.5rem;
            font-size: 1.05rem;
            font-weight: 700;
            color: #0f172a;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .sidebar-menu {
            padding: 1rem 0.75rem;
        }
        .sidebar-heading {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94a3b8;
            padding: 0.75rem 0.75rem 0.35rem 0.75rem;
        }
        .nav-link-custom {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 0.85rem;
            color: #475569;
            font-weight: 500;
            font-size: 0.875rem;
            border-radius: 0.5rem;
            text-decoration: none;
            transition: all 0.15s ease-in-out;
            margin-bottom: 0.2rem;
        }
        .nav-link-custom:hover {
            background-color: #f1f5f9;
            color: var(--primary-color);
        }
        .nav-link-custom.active {
            background-color: #eff6ff;
            color: var(--primary-color);
            font-weight: 600;
        }
        .top-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.75rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 990;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
        }
        .badge-role-admin { background-color: #dbeafe; color: #1e40af; }
        .badge-role-gv { background-color: #d1fae5; color: #065f46; }
        .badge-role-sv { background-color: #f1f5f9; color: #334155; }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar Navigation -->
        <div id="sidebar-wrapper">
            <div class="sidebar-brand">
                <i class="bi bi-mortarboard-fill text-primary fs-3"></i>
                <div>
                    <div class="fw-bold" style="letter-spacing: -0.02em;">KHOA CNTT - CTUET</div>
                    <small class="text-muted fw-normal" style="font-size: 0.72rem;">Quản Lý Thực Tập Doanh Nghiệp</small>
                </div>
            </div>

            <div class="sidebar-menu">
                @if (User.IsInRole("admin"))
                {
                    <div class="sidebar-heading">Quản trị Khoa</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard Thống kê
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "SinhVien" ? "active" : "")" 
                       asp-area="Admin" asp-controller="SinhVien" asp-action="Index">
                        <i class="bi bi-people"></i> Quản lý Sinh viên & Phân công
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "GiangVien" ? "active" : "")" 
                       asp-area="Admin" asp-controller="GiangVien" asp-action="Index">
                        <i class="bi bi-person-workspace"></i> Quản lý Giảng viên
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "DotThucTap" ? "active" : "")" 
                       asp-area="Admin" asp-controller="DotThucTap" asp-action="Index">
                        <i class="bi bi-calendar3"></i> Cấu hình Đợt thực tập
                    </a>
                }
                else if (User.IsInRole("giang_vien"))
                {
                    <div class="sidebar-heading">Giảng viên Hướng dẫn</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                       asp-area="GiangVien" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard GVHD
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "YeuCau" ? "active" : "")" 
                       asp-area="GiangVien" asp-controller="YeuCau" asp-action="Index">
                        <i class="bi bi-person-plus"></i> Yêu cầu Hướng dẫn
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "SinhVien" ? "active" : "")" 
                       asp-area="GiangVien" asp-controller="SinhVien" asp-action="Index">
                        <i class="bi bi-person-lines-fill"></i> Sinh viên phụ trách & Chấm điểm
                    </a>
                }
                else if (User.IsInRole("sinh_vien"))
                {
                    <div class="sidebar-heading">Sinh viên Thực tập</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Tổng quan tiến độ
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "DangKy" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="DangKy" asp-action="Index">
                        <i class="bi bi-building-check"></i> Đăng ký Nơi thực tập
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "DeCuong" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="DeCuong" asp-action="Index">
                        <i class="bi bi-file-earmark-text"></i> Đề cương kế hoạch
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "DinhKy" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="BaoCao" asp-action="DinhKy">
                        <i class="bi bi-journal-check"></i> Nhật ký định kỳ
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "TongKet" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="BaoCao" asp-action="TongKet">
                        <i class="bi bi-file-earmark-pdf"></i> Nộp báo cáo GK/CK
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "KetQua" ? "active" : "")" 
                       asp-area="SinhVien" asp-controller="KetQua" asp-action="Index">
                        <i class="bi bi-award"></i> Kết quả đánh giá
                    </a>
                }
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper" class="w-100">
            <!-- Top Navbar -->
            <div class="top-navbar d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="fw-bold text-dark d-none d-lg-block" style="font-size: 0.95rem;">
                        <i class="bi bi-mortarboard-fill text-primary me-1"></i> Khoa Công nghệ Thông tin
                        <span class="text-muted fw-normal ms-1">| Thực tập Doanh nghiệp</span>
                    </div>
                    @if (User.IsInRole("admin") && danhSachDot.Any())
                    {
                        <form id="formChangeSemester" method="post" asp-area="Admin" asp-controller="DotThucTap" asp-action="ChonKy" class="d-inline-block">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-primary border fw-semibold">
                                    <i class="bi bi-calendar3 me-1"></i> Kỳ thực tập:
                                </span>
                                <select name="dotId" class="form-select border fw-bold text-primary" onchange="document.getElementById('formChangeSemester').submit();" style="min-width: 220px;">
                                    @foreach (var dot in danhSachDot)
                                    {
                                        <option value="@dot.Id" selected="@(dot.Id == selectedDotId ? "selected" : null)">
                                            @dot.TenDot @(dot.TrangThaiKichHoat ? "★ (Hiện tại)" : "")
                                        </option>
                                    }
                                </select>
                            </div>
                        </form>
                    }
                    else if (dotDangChon != null)
                    {
                        <div class="badge bg-light text-primary border px-2.5 py-1.5 fs-7 fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i> @dotDangChon.TenDot
                        </div>
                    }
                </div>

                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var role = User.FindFirst(ClaimTypes.Role)?.Value;
                        string badgeClass = role switch {
                            "admin" => "badge-role-admin",
                            "giang_vien" => "badge-role-gv",
                            _ => "badge-role-sv"
                        };
                        string roleName = role switch {
                            "admin" => "Quản trị viên",
                            "giang_vien" => "Giảng viên",
                            _ => "Sinh viên"
                        };

                        <span class="badge @badgeClass px-2.5 py-1.5 rounded-pill fs-7">
                            <i class="bi bi-shield-check me-1"></i>@roleName
                        </span>

                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" 
                                    type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i>
                                <span>@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-sm btn-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                        </a>
                    }
                </div>
            </div>

            <!-- Main Body -->
            <main class="p-4 flex-grow-1">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-white border-top py-3 text-center text-muted small">
                &copy; @DateTime.Now.Year - Đồ án 4: Hệ thống Quản lý Thực tập Tốt nghiệp - C# ASP.NET Core MVC & PostgreSQL
            </footer>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
