@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Quản Lý Thực Tập Doanh Nghiệp (Khoa CNTT - CTUET)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: system-ui, -apple-system, sans-serif;
            padding: 1.5rem;
        }
        @@media (max-width: 576px) {
            body {
                padding: 0.75rem 0.5rem;
            }
            .login-header {
                padding: 1.5rem 1rem 1.25rem 1rem !important;
            }
            .login-header h4 {
                font-size: 1.15rem;
            }
            .form-control {
                font-size: 16px !important; /* Ngăn iOS tự động phóng to màn hình khi nhập */
            }
        }
        .login-card {
            width: 100%;
            max-width: 480px;
            background: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }
        .login-header {
            background: #2563eb;
            color: #ffffff;
            padding: 2rem 2rem 1.5rem 2rem;
            text-align: center;
        }
        .demo-btn {
            font-size: 0.75rem;
            padding: 0.4rem 0.65rem;
            border-radius: 0.375rem;
            min-height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <i class="bi bi-mortarboard-fill fs-1"></i>
            <h4 class="fw-bold mt-2 mb-1">HỆ THỐNG THỰC TẬP DOANH NGHIỆP</h4>
            <p class="mb-0 text-white-75 fs-7 small">Khoa Công nghệ Thông tin - CTUET</p>
            <div class="text-white-50 mt-1" style="font-size: 0.72rem;">Hệ thống thông tin • Công nghệ thông tin • Khoa học máy tính • Kỹ thuật phần mềm</div>
        </div>

        <div class="p-3 p-sm-4">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 small py-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }

            <!-- Nút đăng nhập với Google -->
            <a asp-action="GoogleLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" 
               class="btn btn-light border w-100 py-2 fw-semibold shadow-sm mb-3 d-flex align-items-center justify-content-center gap-2 text-dark text-decoration-none"
               style="background: #ffffff; border-color: #d1d5db !important; font-size: 0.92rem; transition: all 0.2s;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48">
                    <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20s20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
                    <path fill="#FF3D00" d="m6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691z"/>
                    <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
                    <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
                </svg>
                <span>Đăng nhập với tài khoản Google</span>
            </a>

            <div class="position-relative text-center my-3">
                <hr class="text-secondary opacity-25 m-0">
                <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 text-muted small" style="font-size: 0.76rem;">HOẶC SỬ DỤNG MÃ NỘI BỘ</span>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Tên đăng nhập / MSSV / Mã GV</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                        <input type="text" id="tenDangNhap" name="tenDangNhap" class="form-control border-start-0 ps-0" 
                               placeholder="Nhập MSSV hoặc Mã GV" required autofocus />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small text-secondary">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                        <input type="password" id="matKhau" name="matKhau" class="form-control border-start-0 ps-0" 
                               placeholder="Nhập mật khẩu (mặc định: 123456)" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập hệ thống
                </button>
            </form>

            <div class="border-top pt-3 mt-2">
                <p class="text-muted small fw-semibold text-center mb-2">Điền nhanh tài khoản kiểm thử (Demo 4 ngành):</p>
                <div class="d-flex flex-wrap gap-1.5 justify-content-center">
                    <button type="button" class="btn btn-outline-primary demo-btn" onclick="fillAccount('admin', '123456')">
                        <i class="bi bi-shield-lock me-1"></i>Admin Khoa
                    </button>
                    <button type="button" class="btn btn-outline-success demo-btn" onclick="fillAccount('GV_THUYANH', '123456')">
                        <i class="bi bi-person-workspace me-1"></i>ThS. Thúy Anh (GVHD)
                    </button>
                    <button type="button" class="btn btn-outline-secondary demo-btn" onclick="fillAccount('HTTT2311017', '123456')">
                        <i class="bi bi-person me-1"></i>SV HTTT (Đông)
                    </button>
                    <button type="button" class="btn btn-outline-info demo-btn" onclick="fillAccount('CNTT2311052', '123456')">
                        <i class="bi bi-person me-1"></i>SV CNTT (Tuấn)
                    </button>
                    <button type="button" class="btn btn-outline-warning demo-btn text-dark" onclick="fillAccount('KHMT2311042', '123456')">
                        <i class="bi bi-person me-1"></i>SV KHMT (Toàn)
                    </button>
                    <button type="button" class="btn btn-outline-dark demo-btn" onclick="fillAccount('KTPM2311004', '123456')">
                        <i class="bi bi-person me-1"></i>SV KTPM (Lương)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function fillAccount(username, password) {
            document.getElementById('tenDangNhap').value = username;
            document.getElementById('matKhau').value = password;
        }
    </script>
</body>
</html>
