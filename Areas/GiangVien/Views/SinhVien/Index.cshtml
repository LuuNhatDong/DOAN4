@model IEnumerable<QuanLyThucTap.Models.PhanCongHuongDan>
@{
    ViewData["Title"] = "Sinh viên phụ trách";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Danh Sách Sinh Viên Phụ Trách</h4>
        <p class="text-muted small mb-0">Theo dõi tiến độ, duyệt đề cương và chấm điểm từng sinh viên</p>
    </div>
</div>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 100px; white-space: nowrap;">MSSV</th>
                    <th style="min-width: 150px;">Họ và Tên</th>
                    <th style="min-width: 95px; white-space: nowrap;">Lớp</th>
                    <th style="min-width: 190px;">Công ty thực tập</th>
                    <th style="min-width: 130px; white-space: nowrap;">Chu kỳ báo cáo</th>
                    <th style="min-width: 220px;">Đề tài</th>
                    <th style="min-width: 125px; white-space: nowrap;">Trạng thái</th>
                    <th class="text-end" style="min-width: 130px; white-space: nowrap;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Chưa có sinh viên nào trong danh sách.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary" style="white-space: nowrap;">@item.SinhVien?.Mssv</td>
                        <td class="fw-semibold" style="min-width: 150px; white-space: normal;">@item.SinhVien?.Hovaten</td>
                        <td><span class="badge bg-light text-dark border">@item.SinhVien?.Lop</span></td>
                        <td style="min-width: 190px; white-space: normal;">@(item.DoanhNghiep?.TenVietTat ?? item.TenCtyNgoai ?? "Chưa đăng ký")</td>
                        <td style="white-space: nowrap;">
                            <span class="badge bg-light text-secondary border">
                                @(item.LoaiChuKyBaoCao == "theo_tuan" ? "Theo tuần" : "Theo tháng")
                            </span>
                        </td>
                        <td style="min-width: 220px; max-width: 320px;">
                            <div class="small fw-semibold text-body" style="white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.45;" title="@(item.DeCuongThucTap?.TenDeTai)">
                                @(item.DeCuongThucTap?.TenDeTai ?? "Chưa có đề tài")
                            </div>
                        </td>
                        <td style="white-space: nowrap;">
                            @switch (item.TrangThaiDuyet)
                            {
                                case "dang_thuc_tap":
                                    <span class="badge bg-primary">Đang thực tập</span>
                                    break;
                                case "hoan_thanh":
                                    <span class="badge bg-success">Hoàn thành</span>
                                    break;
                                default:
                                    <span class="badge bg-warning text-dark">@item.TrangThaiDuyet</span>
                                    break;
                            }
                        </td>
                        <td class="text-end" style="white-space: nowrap;">
                            <a asp-action="Detail" asp-route-phanCongId="@item.Id" class="btn btn-sm btn-primary py-1 px-2.5 text-center d-inline-block shadow-sm" style="line-height: 1.3; font-size: 0.8rem; white-space: nowrap;">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Quản lý &amp;<br />Chấm điểm
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
