@model QuanLyThucTap.Models.DoanhNghiep
@{
    ViewData["Title"] = "Thêm Doanh nghiệp đối tác";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h4 class="fw-bold mb-3"><i class="bi bi-building-add text-primary me-2"></i>Thêm Doanh Nghiệp Đối Tác</h4>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Mã số thuế *</label>
                        <input asp-for="MaSoThue" class="form-control" placeholder="0101778163" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Tên viết tắt *</label>
                        <input asp-for="TenVietTat" class="form-control" placeholder="FPT Software" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold small">Tên đầy đủ Doanh nghiệp *</label>
                        <input asp-for="TenDoanhNghiep" class="form-control" placeholder="Công ty Cổ phần Phần mềm FPT" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold small">Địa chỉ trụ sở / chi nhánh *</label>
                        <textarea asp-for="DiaChi" class="form-control" rows="2" placeholder="Khu Công nghệ Cao, TP. Cần Thơ" required></textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Website</label>
                        <input asp-for="Website" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Người liên hệ</label>
                        <input asp-for="NguoiLienHe" class="form-control" placeholder="Nguyễn Văn Cường" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Số điện thoại liên hệ</label>
                        <input asp-for="SdtLienHe" class="form-control" placeholder="02923123456" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Lưu Doanh Nghiệp</button>
                </div>
            </form>
        </div>
    </div>
</div>
