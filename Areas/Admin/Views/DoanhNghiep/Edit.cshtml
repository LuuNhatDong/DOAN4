@model QuanLyThucTap.Models.DoanhNghiep
@{
    ViewData["Title"] = "Chỉnh sửa Doanh nghiệp";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h4 class="fw-bold mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Doanh Nghiệp: @Model.TenVietTat</h4>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Mã số thuế</label>
                        <input asp-for="MaSoThue" class="form-control bg-light" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Tên viết tắt *</label>
                        <input asp-for="TenVietTat" class="form-control" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold small">Tên đầy đủ Doanh nghiệp *</label>
                        <input asp-for="TenDoanhNghiep" class="form-control" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold small">Địa chỉ *</label>
                        <textarea asp-for="DiaChi" class="form-control" rows="2" required></textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Website</label>
                        <input asp-for="Website" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Người liên hệ</label>
                        <input asp-for="NguoiLienHe" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Số điện thoại liên hệ</label>
                        <input asp-for="SdtLienHe" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Trạng thái hợp tác</label>
                        <select asp-for="TrangThai" class="form-select">
                            <option value="hoat_dong">Đang hợp tác</option>
                            <option value="ngung_hop_tac">Ngừng hợp tác</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>
