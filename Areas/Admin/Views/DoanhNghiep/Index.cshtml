@model IEnumerable<QuanLyThucTap.Models.DoanhNghiep>
@{
    ViewData["Title"] = "Đối tác Doanh nghiệp";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Mạng Lưới Doanh Nghiệp Đối Tác</h4>
        <p class="text-muted small mb-0">Danh sách công ty tiếp nhận sinh viên thực tập</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1">
        <i class="bi bi-building-add"></i> Thêm Doanh Nghiệp
    </a>
</div>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã số thuế</th>
                    <th>Tên Doanh nghiệp</th>
                    <th>Tên viết tắt</th>
                    <th>Địa chỉ</th>
                    <th>Người liên hệ</th>
                    <th class="text-center">Số SV tiếp nhận</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.MaSoThue</td>
                        <td class="fw-semibold text-primary">@item.TenDoanhNghiep</td>
                        <td><span class="badge bg-light text-dark border">@item.TenVietTat</span></td>
                        <td class="small text-muted" style="max-width: 250px;">@item.DiaChi</td>
                        <td>
                            <div>@item.NguoiLienHe</div>
                            <small class="text-muted">@item.SdtLienHe</small>
                        </td>
                        <td class="text-center"><span class="badge bg-info bg-opacity-10 text-info border">@item.DanhSachPhanCong.Count SV</span></td>
                        <td>
                            @if (item.TrangThai == "hoat_dong")
                            {
                                <span class="badge bg-success">Đang hợp tác</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng hợp tác</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
