@model IEnumerable<QuanLyThucTap.Models.DotThucTap>
@{
    ViewData["Title"] = "Cấu hình Đợt thực tập";
}

<style>
    /* Nền hàng đợt thực tập đang kích hoạt mềm mại, đồng bộ ở cả 2 chế độ */
    tr.table-primary td, tr.table-primary th {
        background-color: rgba(11, 78, 194, 0.07) !important;
        box-shadow: none !important;
    }
    [data-bs-theme="dark"] tr.table-primary td,
    [data-bs-theme="dark"] tr.table-primary th {
        background-color: rgba(37, 99, 235, 0.16) !important;
        box-shadow: none !important;
        color: #f1f5f9 !important;
        border-color: #1e3a8a !important;
    }
</style>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Quản Lý Các Đợt Thực Tập</h4>
        <p class="text-muted small mb-0">Thiết lập học kỳ, mốc thời hạn nộp đề cương và kích hoạt đợt hiện tại</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1">
        <i class="bi bi-calendar-plus"></i> Tạo Đợt Mới
    </a>
</div>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 155px;">Tên đợt thực tập</th>
                    <th style="min-width: 95px; white-space: nowrap;">Năm học</th>
                    <th style="min-width: 135px; white-space: nowrap;">Thời gian diễn ra</th>
                    <th style="min-width: 125px; white-space: nowrap;">Hạn đăng ký Cty</th>
                    <th style="min-width: 125px; white-space: nowrap;">Hạn nộp đề cương</th>
                    <th class="text-center" style="min-width: 125px; white-space: nowrap;">Trạng thái</th>
                    <th class="text-end" style="min-width: 160px; white-space: nowrap;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var durationDays = (item.NgayKetThuc - item.NgayBatDau).TotalDays;
                    var soTuan = Math.Max(1, (int)Math.Round(durationDays / 7.0));
                    var soThang = Math.Max(1, (int)Math.Round(durationDays / 30.0));

                    <tr class="@(item.TrangThaiKichHoat ? "table-primary" : "")">
                        <td class="fw-bold" style="min-width: 155px; white-space: normal;">
                            @if (item.TenDot.Contains(" HK") && item.TenDot.Contains("("))
                            {
                                var idxHk = item.TenDot.IndexOf(" HK");
                                var part1 = item.TenDot.Substring(0, idxHk);
                                var rest = item.TenDot.Substring(idxHk + 1);
                                var idxYear = rest.IndexOf(" (");
                                var hkPart = idxYear > 0 ? rest.Substring(0, idxYear) : rest;
                                var yearPart = idxYear > 0 ? rest.Substring(idxYear).Trim() : "";

                                <span class="d-none d-md-inline">@item.TenDot</span>
                                <span class="d-inline d-md-none">
                                    @part1<br />
                                    @hkPart<br />
                                    @yearPart
                                </span>
                            }
                            else
                            {
                                @item.TenDot
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@item.NamHoc</span></td>
                        <td style="min-width: 135px;">
                            <div class="small fw-semibold text-body">
                                <span class="d-none d-md-inline text-nowrap">
                                    <i class="bi bi-calendar3 text-primary me-1"></i>@item.NgayBatDau.ToString("dd/MM/yyyy") - @item.NgayKetThuc.ToString("dd/MM/yyyy")
                                </span>
                                <span class="d-inline d-md-none text-nowrap">
                                    <i class="bi bi-calendar3 text-primary me-1"></i>@item.NgayBatDau.ToString("dd/MM/yyyy") -<br />
                                    <span class="ms-3 ps-1">@item.NgayKetThuc.ToString("dd/MM/yyyy")</span>
                                </span>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle mt-1" style="font-size: 0.72rem;">
                                @soTuan tuần (@soThang tháng)
                            </span>
                        </td>
                        <td class="small text-danger fw-semibold" style="white-space: nowrap;">@item.HanDangKyCty.ToString("dd/MM/yyyy")</td>
                        <td class="small text-danger fw-semibold" style="white-space: nowrap;">@item.HanNopDeCuong.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            @if (item.TrangThaiKichHoat)
                            {
                                <span class="badge bg-success px-2.5 py-1.5"><i class="bi bi-check-circle me-1"></i>Đang kích hoạt</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Không hoạt động</span>
                            }
                        </td>
                        <td class="text-end" style="white-space: nowrap;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="bi bi-pencil me-1"></i>Sửa
                            </a>
                            <a asp-action="ChiTiet" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-eye me-1"></i>Xem SV
                            </a>
                            @if (!item.TrangThaiKichHoat)
                            {
                                <form asp-action="SetActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-lightning-fill me-1"></i>Kích hoạt
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
