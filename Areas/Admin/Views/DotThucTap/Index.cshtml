@model IEnumerable<QuanLyThucTap.Models.DotThucTap>
@{
    ViewData["Title"] = "Cấu hình Đợt thực tập";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Quản Lý Các Đợt Thực Tập</h4>
        <p class="text-muted small mb-0">Thiết lập học kỳ, mốc thời hạn nộp đề cương và kích hoạt đợt hiện tại</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1">
        <i class="bi bi-calendar-plus"></i> Tạo Đợt Mới
    </a>
</div>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tên đợt thực tập</th>
                    <th>Năm học</th>
                    <th>Thời gian diễn ra</th>
                    <th>Hạn đăng ký Cty</th>
                    <th>Hạn nộp đề cương</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.TrangThaiKichHoat ? "table-primary bg-opacity-25" : "")">
                        <td class="fw-bold">@item.TenDot</td>
                        <td><span class="badge bg-light text-dark border">@item.NamHoc</span></td>
                        <td class="small">@item.NgayBatDau.ToString("dd/MM/yyyy") - @item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                        <td class="small text-danger fw-semibold">@item.HanDangKyCty.ToString("dd/MM/yyyy")</td>
                        <td class="small text-danger fw-semibold">@item.HanNopDeCuong.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            @if (item.TrangThaiKichHoat)
                            {
                                <span class="badge bg-success px-2.5 py-1.5"><i class="bi bi-check-circle me-1"></i>Đang kích hoạt</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Không hoạt động</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="ChiTiet" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-eye me-1"></i>Xem thông tin đợt
                            </a>
                            @if (!item.TrangThaiKichHoat)
                            {
                                <form asp-action="SetActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-lightning-fill me-1"></i>Kích hoạt
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
