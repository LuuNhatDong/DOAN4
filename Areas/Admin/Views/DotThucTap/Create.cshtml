@model QuanLyThucTap.Models.DotThucTap
@{
    ViewData["Title"] = "Tạo đợt thực tập mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h4 class="fw-bold mb-3"><i class="bi bi-calendar-plus text-primary me-2"></i>Tạo Đợt Thực Tập Mới</h4>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-semibold small">Tên đợt thực tập *</label>
                        <input asp-for="TenDot" class="form-control" placeholder="Ví dụ: Thực tập tốt nghiệp HK1 (2026 - 2027)" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Năm học *</label>
                        <input asp-for="NamHoc" class="form-control" placeholder="2026 - 2027" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Ngày bắt đầu *</label>
                        <input asp-for="NgayBatDau" type="date" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Ngày kết thúc *</label>
                        <input asp-for="NgayKetThuc" type="date" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Hạn đăng ký nơi thực tập *</label>
                        <input asp-for="HanDangKyCty" type="date" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Hạn nộp đề cương thực tập *</label>
                        <input asp-for="HanNopDeCuong" type="date" class="form-control" required />
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="TrangThaiKichHoat" class="form-check-input" type="checkbox" id="kichHoatSwitch" />
                            <label class="form-check-label fw-semibold" for="kichHoatSwitch">
                                Kích hoạt làm đợt thực tập chính thức ngay bây giờ
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Lưu Đợt Thực Tập</button>
                </div>
            </form>
        </div>
    </div>
</div>
