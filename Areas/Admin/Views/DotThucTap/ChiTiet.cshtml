@model QuanLyThucTap.Models.DotThucTap
@{
    ViewData["Title"] = "Chi tiết đợt thực tập - " + Model.TenDot;
    var allPhanCongs = ViewBag.AllPhanCongs as List<QuanLyThucTap.Models.PhanCongHuongDan> 
                       ?? Model.DanhSachPhanCong.Where(p => p.SinhVien != null && p.SinhVien.TrangThai == "hoat_dong").ToList();
    var pagedPhanCongs = ViewBag.PagedPhanCongs as List<QuanLyThucTap.Models.PhanCongHuongDan> 
                         ?? allPhanCongs.Take(10).ToList();
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : allPhanCongs.Count;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đợt
        </a>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-calendar3-range text-primary me-2"></i>@Model.TenDot
            @if (Model.TrangThaiKichHoat)
            {
                <span class="badge bg-success ms-2 fs-7 align-middle">Đang kích hoạt</span>
            }
        </h4>
        @{
            var durationDays = (Model.NgayKetThuc - Model.NgayBatDau).TotalDays;
            var soTuan = Math.Max(1, (int)Math.Round(durationDays / 7.0));
            var soThang = Math.Max(1, (int)Math.Round(durationDays / 30.0));
        }
        <p class="text-muted small mb-0">
            Thời gian diễn ra cố định: <strong>@Model.NgayBatDau.ToString("dd/MM/yyyy")</strong> đến <strong>@Model.NgayKetThuc.ToString("dd/MM/yyyy")</strong> 
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">@soTuan tuần (@soThang tháng)</span>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pencil me-1"></i> Chỉnh sửa đợt
        </a>
        <form asp-action="ChonKy" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="dotId" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-check2-circle me-1"></i> Đặt làm kỳ đang xem
            </button>
        </form>
    </div>
</div>

<!-- Thống kê nhanh của đợt -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 border-start border-4 border-primary">
            <div class="text-muted small">Tổng sinh viên tham gia</div>
            <div class="fs-4 fw-bold text-primary">@allPhanCongs.Count</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 border-start border-4 border-success">
            <div class="text-muted small">Đang thực tập chính thức</div>
            <div class="fs-4 fw-bold text-success">@allPhanCongs.Count(p => p.TrangThaiDuyet == "dang_thuc_tap")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 border-start border-4 border-warning">
            <div class="text-muted small">Chờ phê duyệt GVHD / DN</div>
            <div class="fs-4 fw-bold text-warning">@allPhanCongs.Count(p => p.TrangThaiDuyet == "cho_duyet")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 border-start border-4 border-info">
            <div class="text-muted small">Đã hoàn thành đợt</div>
            <div class="fs-4 fw-bold text-info">@allPhanCongs.Count(p => p.TrangThaiDuyet == "hoan_thanh")</div>
        </div>
    </div>
</div>

<!-- Danh sách sinh viên trong đợt này -->
<div class="card overflow-hidden">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Danh Sách Sinh Viên Trong Đợt Này</h5>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
            Tổng số: @totalItems sinh viên
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 105px; white-space: nowrap;">MSSV</th>
                    <th style="min-width: 145px;">Họ và Tên</th>
                    <th style="min-width: 135px; white-space: nowrap;">Lớp - Ngành</th>
                    <th style="min-width: 170px; max-width: 250px;">Nơi Thực Tập</th>
                    <th style="min-width: 135px; max-width: 170px;">Vị trí</th>
                    <th style="min-width: 145px; white-space: nowrap;">GVHD Phụ trách</th>
                    <th style="min-width: 115px; white-space: nowrap;">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!pagedPhanCongs.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Chưa có sinh viên nào trong đợt thực tập này.</td>
                    </tr>
                }
                @foreach (var pc in pagedPhanCongs)
                {
                    <tr>
                        <td class="fw-bold text-primary" style="white-space: nowrap;">@pc.SinhVien?.Mssv</td>
                        <td class="fw-semibold" style="min-width: 145px; white-space: normal;">@pc.SinhVien?.Hovaten</td>
                        <td style="min-width: 135px;">
                            <span class="badge bg-light text-dark border">@pc.SinhVien?.Lop</span>
                            <small class="text-muted d-block" style="white-space: nowrap;">@pc.SinhVien?.ChuyenNganh</small>
                        </td>
                        <td style="min-width: 170px; max-width: 250px; white-space: normal;">
                            @{
                                var tenCty = pc.DoanhNghiep?.TenDoanhNghiep ?? pc.TenCtyNgoai ?? "Chưa khai báo";
                                bool coTheMoRong = tenCty.Length > 16 || !string.IsNullOrEmpty(pc.MentorDoanhNghiep);
                            }
                            <!-- 1. Giao diện Desktop (Màn hình lớn): Giữ nguyên như cũ (tên cty + mentor, không sđt, không địa chỉ), xuống dòng tự nhiên không trượt ngang -->
                            <div class="d-none d-md-block" style="white-space: normal;">
                                <strong class="text-dark d-block">@tenCty</strong>
                                @if (!string.IsNullOrEmpty(pc.MentorDoanhNghiep))
                                {
                                    <small class="text-muted d-block mt-0.5">
                                        <i class="bi bi-person me-1"></i>Mentor: @pc.MentorDoanhNghiep
                                    </small>
                                }
                            </div>

                            <!-- 2. Giao diện Mobile: Ấn xem chi tiết thì bỏ dấu 3 chấm và hiển thị đầy đủ tên cty cùng với mentor ngay trong ô, không tạo thêm ô box -->
                            <div class="d-md-none">
                                @if (coTheMoRong)
                                {
                                    <!-- Khi thu gọn: 1 dòng có 3 chấm -->
                                    <div id="companyShort_@pc.Id">
                                        <div class="fw-semibold text-dark text-truncate" style="max-width: 155px;" title="@tenCty">
                                            <i class="bi bi-building text-primary me-1"></i>@tenCty
                                        </div>
                                        <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none text-primary d-inline-flex align-items-center gap-1 mt-0.5" 
                                                onclick="toggleCompanyMobile(@pc.Id, true)" style="font-size: 0.78rem;">
                                            <span>Xem chi tiết</span><i class="bi bi-chevron-down" style="font-size: 0.68rem;"></i>
                                        </button>
                                    </div>

                                    <!-- Khi mở rộng: Bỏ 3 chấm, hiển thị đầy đủ tên cty và mentor, không tạo thêm ô popup/card -->
                                    <div id="companyFull_@pc.Id" style="display: none;">
                                        <div class="fw-semibold text-dark" style="white-space: normal;">
                                            <i class="bi bi-building text-primary me-1"></i>@tenCty
                                        </div>
                                        <small class="text-muted d-block mt-0.5" style="white-space: normal;">
                                            <i class="bi bi-person me-1"></i>Mentor: <span class="text-dark fw-medium">@(string.IsNullOrEmpty(pc.MentorDoanhNghiep) ? "Chưa có" : pc.MentorDoanhNghiep)</span>
                                        </small>
                                        <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none text-primary d-inline-flex align-items-center gap-1 mt-0.5" 
                                                onclick="toggleCompanyMobile(@pc.Id, false)" style="font-size: 0.78rem;">
                                            <span>Thu gọn</span><i class="bi bi-chevron-up" style="font-size: 0.68rem;"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="fw-semibold text-dark" style="white-space: normal;">
                                        <i class="bi bi-building text-primary me-1"></i>@tenCty
                                    </div>
                                }
                            </div>
                        </td>
                        <td style="min-width: 135px; max-width: 170px; white-space: normal;">@(pc.ViTriThucTap ?? "---")</td>
                        <td style="white-space: nowrap;">
                            @if (pc.GiangVien != null)
                            {
                                <span class="badge bg-info bg-opacity-10 text-info border">
                                    <i class="bi bi-person-check me-1"></i>@pc.GiangVien.Hovaten
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning border">Chưa phân công</span>
                            }
                        </td>
                        <td style="white-space: nowrap;">
                            @switch (pc.TrangThaiDuyet)
                            {
                                case "dang_thuc_tap":
                                    <span class="badge bg-primary">Đang thực tập</span>
                                    break;
                                case "hoan_thanh":
                                    <span class="badge bg-success">Hoàn thành</span>
                                    break;
                                case "cho_duyet":
                                    <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@pc.TrangThaiDuyet</span>
                                    break;
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang 10 sinh viên / trang -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center py-3">
            <div class="small text-muted mb-2 mb-md-0">
                Hiển thị <strong>@pagedPhanCongs.Count</strong> / <strong>@totalItems</strong> sinh viên (Trang @currentPage / @totalPages)
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="ChiTiet" 
                           asp-route-id="@Model.Id" 
                           asp-route-page="@(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i> Trước
                        </a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(currentPage == p ? "active" : "")">
                            <a class="page-link" asp-action="ChiTiet" 
                               asp-route-id="@Model.Id" 
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="ChiTiet" 
                           asp-route-id="@Model.Id" 
                           asp-route-page="@(currentPage + 1)">
                            Sau <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleCompanyMobile(id, showFull) {
            const shortEl = document.getElementById('companyShort_' + id);
            const fullEl = document.getElementById('companyFull_' + id);
            if (shortEl && fullEl) {
                if (showFull) {
                    shortEl.style.display = 'none';
                    fullEl.style.display = 'block';
                } else {
                    fullEl.style.display = 'none';
                    shortEl.style.display = 'block';
                }
            }
        }
    </script>
}
