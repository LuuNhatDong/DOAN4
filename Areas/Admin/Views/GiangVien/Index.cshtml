@model IEnumerable<QuanLyThucTap.Models.GiangVien>
@{
    ViewData["Title"] = "Quản lý Giảng viên";
    var dotId = (long)(ViewBag.DotId ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Danh Sách Giảng Viên Khoa Công Nghệ Thông Tin</h4>
        <p class="text-muted small mb-0">
            Giảng viên cố định của Trường/Khoa - Quản lý hồ sơ và chỉ tiêu hướng dẫn thực tập tối đa
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1">
        <i class="bi bi-person-plus-fill"></i> Thêm Giảng Viên Mới
    </a>
</div>

<!-- Bộ lọc -->
<div class="card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo Mã GV, họ tên, email..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="trangThai" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="hoat_dong" selected="@(ViewBag.TrangThai == "hoat_dong" ? "selected" : null)">Đang công tác (Hoạt động)</option>
                <option value="da_an" selected="@(ViewBag.TrangThai == "da_an" ? "selected" : null)">Đã ẩn</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
        </div>
    </form>
</div>

<!-- Bảng Giảng viên -->
<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã GV</th>
                    <th>Họ và Tên</th>
                    <th>Học vị</th>
                    <th>Bộ môn</th>
                    <th>Email & Điện thoại</th>
                    <th class="text-center" style="min-width: 180px;">Chỉ tiêu Hướng dẫn (CSDL)</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy giảng viên nào.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    int dangHuongDan = item.DanhSachPhanCong.Count(p => (dotId == 0 || p.DotThucTapId == dotId) && p.TrangThaiDuyet != "tu_choi");
                    int pct = item.SoLuongToiDa > 0 ? (int)((double)dangHuongDan / item.SoLuongToiDa * 100) : 0;
                    bool isFull = dangHuongDan >= item.SoLuongToiDa;

                    <tr class="@(item.TrangThai == "da_an" ? "table-light text-muted opacity-75" : "")">
                        <td class="fw-bold text-success">@item.Magv</td>
                        <td>
                            <span class="fw-bold text-dark">@item.Hovaten</span>
                            @if (item.Magv == "GV_HTTT01")
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border ms-1" style="font-size: 0.7rem;">Trưởng BM</span>
                            }
                            else if (item.Magv == "GV_HTTT02")
                            {
                                <span class="badge bg-info bg-opacity-10 text-info border ms-1" style="font-size: 0.7rem;">Phó BM</span>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@item.HocVi</span></td>
                        <td>@item.BoMon</td>
                        <td>
                            <div>@item.Email</div>
                            <small class="text-muted"><i class="bi bi-telephone me-1"></i>@(item.Sdt ?? "---")</small>
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center align-items-center gap-2 mb-1">
                                <span class="badge @(isFull ? "bg-danger" : "bg-success") px-2 py-1 fs-7">
                                    @dangHuongDan / @item.SoLuongToiDa SV
                                </span>
                                <!-- Nút sửa nhanh số lượng tối đa -->
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" 
                                        data-bs-toggle="modal" data-bs-target="#modalEditQuota_@item.Id" title="Chỉnh sửa chỉ tiêu tối đa">
                                    <i class="bi bi-gear-fill"></i>
                                </button>
                            </div>
                            <div class="progress mx-auto" style="height: 6px; width: 120px;">
                                <div class="progress-bar @(isFull ? "bg-danger" : "bg-success")" role="progressbar" style="width: @Math.Min(pct, 100)%;"></div>
                            </div>
                        </td>
                        <td class="text-center">
                            @if (item.TrangThai == "hoat_dong")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border">Đang công tác</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đã ẩn</span>
                            }
                        </td>
                        <td class="text-end" style="white-space: nowrap; width: 1%;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa thông tin">
                                <i class="bi bi-pencil me-1"></i>Sửa
                            </a>

                            <!-- Modal Chỉnh sửa Chỉ tiêu Hướng Dẫn Tối Đa -->
                            <div class="modal fade text-start" id="modalEditQuota_@item.Id" tabindex="-1">
                                <div class="modal-dialog modal-sm">
                                    <div class="modal-content">
                                        <form asp-action="CapNhatSoLuong" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />

                                            <div class="modal-header">
                                                <h6 class="modal-title fw-bold">Chỉ Tiêu Hướng Dẫn</h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="small text-muted mb-2">Giảng viên: <strong>@item.Hovaten</strong></p>
                                                <label class="form-label small fw-semibold">Số lượng SV tối đa nhận hướng dẫn:</label>
                                                <input type="number" name="soLuongToiDa" min="1" max="50" class="form-control text-center fs-5 fw-bold text-primary" 
                                                       value="@item.SoLuongToiDa" required />
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                                                <button type="submit" class="btn btn-primary btn-sm">Lưu CSDL</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang 10 giảng viên / trang -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center py-3">
            <div class="small text-muted mb-2 mb-md-0">
                Hiển thị <strong>@Model.Count()</strong> / <strong>@ViewBag.TotalItems</strong> giảng viên (Trang @ViewBag.CurrentPage / @ViewBag.TotalPages)
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(ViewBag.CurrentPage - 1)" 
                           asp-route-search="@ViewBag.Search" 
                           asp-route-trangThai="@ViewBag.TrangThai">
                            <i class="bi bi-chevron-left"></i> Trước
                        </a>
                    </li>
                    @for (int p = 1; p <= ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == p ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@p" 
                               asp-route-search="@ViewBag.Search" 
                               asp-route-trangThai="@ViewBag.TrangThai">@p</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(ViewBag.CurrentPage + 1)" 
                           asp-route-search="@ViewBag.Search" 
                           asp-route-trangThai="@ViewBag.TrangThai">
                            Sau <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
