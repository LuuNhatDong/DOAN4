@model QuanLyThucTap.Models.SinhVien
@{
    ViewData["Title"] = "Chỉnh sửa thông tin Sinh viên";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h4 class="fw-bold mb-2"><i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Thông Tin Sinh Viên</h4>
            <p class="text-muted small mb-3">Cập nhật thông tin liên lạc cho sinh viên: <strong>@Model.Hovaten</strong> (@Model.Mssv)</p>

            <div class="alert alert-info border-0 small py-2 mb-3">
                <i class="bi bi-info-circle-fill me-1"></i>
                <strong>Quy định bảo toàn dữ liệu đào tạo:</strong> Các thông tin học thuật (MSSV, Họ tên, Lớp, Chuyên ngành, Email, GPA) được quản lý tập trung và khóa cố định. Quản trị viên chỉ có quyền cập nhật <strong>Số điện thoại liên lạc</strong>.
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-muted">Mã Số Sinh Viên (MSSV)</label>
                        <input asp-for="Mssv" class="form-control bg-light" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-muted">Họ và Tên</label>
                        <input asp-for="Hovaten" class="form-control bg-light" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-muted">Lớp</label>
                        <input asp-for="Lop" class="form-control bg-light" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-muted">Chuyên ngành</label>
                        <input asp-for="ChuyenNganh" class="form-control bg-light" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-muted">Email trường cấp</label>
                        <input asp-for="Email" type="email" class="form-control bg-light" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-muted">Điểm tích lũy (GPA)</label>
                        <input asp-for="Gpa" type="number" step="0.01" class="form-control bg-light" readonly />
                    </div>

                    <div class="col-md-12">
                        <div class="p-3 border border-primary border-opacity-25 rounded-3 bg-primary bg-opacity-10">
                            <label class="form-label fw-bold text-primary small mb-1">
                                <i class="bi bi-telephone-fill me-1"></i> Số điện thoại liên lạc (Được phép chỉnh sửa) *
                            </label>
                            <input asp-for="Sdt" class="form-control form-control-lg fs-6" placeholder="Nhập số điện thoại (ví dụ: 0901234567)" required autofocus />
                            <div class="form-text small text-muted">Số điện thoại dùng để GVHD và Khoa liên hệ khẩn cấp khi cần thiết.</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Lưu Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>
