@model QuanLyThucTap.Models.PhanCongHuongDan
@{
    ViewData["Title"] = "Tổng quan thực tập";
    var sv = ViewBag.SinhVien as QuanLyThucTap.Models.SinhVien;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Xin chào, @sv?.Hovaten</h4>
        <p class="text-muted small mb-0">MSSV: @sv?.Mssv - Lớp: @sv?.Lop - Ngành: @sv?.ChuyenNganh</p>
    </div>
    @if (Model != null)
    {
        @switch (Model.TrangThaiDuyet)
        {
            case "dang_thuc_tap":
                <span class="badge bg-primary px-3 py-2 fs-7 rounded-pill">Đang trong quá trình thực tập</span>
                break;
            case "hoan_thanh":
                <span class="badge bg-success px-3 py-2 fs-7 rounded-pill">Đã hoàn thành thực tập</span>
                break;
            default:
                <span class="badge bg-warning text-dark px-3 py-2 fs-7 rounded-pill">@Model.TrangThaiDuyet</span>
                break;
        }
    }
</div>

<!-- Thẻ thông tin GVHD & Doanh nghiệp -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card p-4 h-100">
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-person-badge me-2"></i>Giảng Viên Hướng Dẫn</h5>
            @if (Model?.GiangVien != null)
            {
                <ul class="list-unstyled mb-0 small">
                    <li class="mb-2"><strong>Họ và tên:</strong> @Model.GiangVien.Hovaten (@Model.GiangVien.HocVi)</li>
                    <li class="mb-2"><strong>Bộ môn:</strong> @Model.GiangVien.BoMon</li>
                    <li class="mb-2"><strong>Email:</strong> @Model.GiangVien.Email</li>
                    <li><strong>Số điện thoại:</strong> @(Model.GiangVien.Sdt ?? "Chưa cập nhật")</li>
                </ul>
            }
            else
            {
                <div class="alert alert-light text-muted mb-0 small">
                    <i class="bi bi-hourglass-split me-1"></i> Khoa đang trong quá trình phân công giảng viên hướng dẫn cho bạn.
                </div>
            }
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-4 h-100">
            <h5 class="fw-bold text-success mb-3"><i class="bi bi-building-check me-2"></i>Nơi Thực Tập</h5>
            @if (Model?.DoanhNghiep != null)
            {
                <ul class="list-unstyled mb-0 small">
                    <li class="mb-2"><strong>Doanh nghiệp:</strong> @Model.DoanhNghiep.TenDoanhNghiep (@Model.DoanhNghiep.TenVietTat)</li>
                    <li class="mb-2"><strong>Vị trí:</strong> @(Model.ViTriThucTap ?? "---")</li>
                    <li class="mb-2">
                        <strong>Thời gian (cố định):</strong> 
                        <span class="badge bg-primary">@(Model.SoThangThucTap) tháng</span>
                        @if (Model.DotThucTap != null)
                        {
                            <span class="text-muted ms-1">(@Model.DotThucTap.NgayBatDau.ToString("dd/MM/yyyy") - @Model.DotThucTap.NgayKetThuc.ToString("dd/MM/yyyy"))</span>
                        }
                    </li>
                    <li><strong>Địa chỉ:</strong> @Model.DoanhNghiep.DiaChi</li>
                </ul>
            }
            else if (!string.IsNullOrEmpty(Model?.TenCtyNgoai))
            {
                <ul class="list-unstyled mb-0 small">
                    <li class="mb-2"><strong>Đơn vị tự tìm:</strong> @Model.TenCtyNgoai</li>
                    <li class="mb-2"><strong>Vị trí:</strong> @(Model.ViTriThucTap ?? "---")</li>
                    <li>
                        <strong>Thời gian (cố định):</strong> 
                        <span class="badge bg-primary">@(Model.SoThangThucTap) tháng</span>
                        @if (Model.DotThucTap != null)
                        {
                            <span class="text-muted ms-1">(@Model.DotThucTap.NgayBatDau.ToString("dd/MM/yyyy") - @Model.DotThucTap.NgayKetThuc.ToString("dd/MM/yyyy"))</span>
                        }
                    </li>
                </ul>
            }
            else
            {
                <div class="alert alert-warning mb-0 small">
                    <i class="bi bi-exclamation-triangle me-1"></i> Bạn chưa đăng ký công ty thực tập.
                    <a asp-action="Index" asp-controller="DangKy" class="alert-link ms-1">Đăng ký ngay</a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Các lối tắt hành động -->
<h5 class="fw-bold mb-3"><i class="bi bi-compass text-secondary me-2"></i>Các Bước Thực Hiện Tiếp Theo</h5>
<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 fs-4">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Đề Cương Kế Hoạch</h6>
                    <p class="text-muted small mb-2">Soạn thảo và nộp kế hoạch đề tài cho GVHD</p>
                    <a asp-controller="DeCuong" asp-action="Index" class="btn btn-sm btn-outline-primary">Vào đề cương</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 fs-4">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Nhật Ký Định Kỳ</h6>
                    <p class="text-muted small mb-2">Nộp báo cáo công việc (@(Model?.LoaiChuKyBaoCao == "theo_tuan" ? "hàng tuần" : "hàng tháng"))</p>
                    <a asp-controller="BaoCao" asp-action="DinhKy" class="btn btn-sm btn-outline-success">Viết nhật ký</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3 fs-4">
                    <i class="bi bi-file-earmark-pdf"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Báo Cáo Tổng Kết</h6>
                    <p class="text-muted small mb-2">Nộp file PDF báo cáo giữa kỳ & cuối kỳ</p>
                    <a asp-controller="BaoCao" asp-action="TongKet" class="btn btn-sm btn-outline-warning text-dark">Nộp báo cáo</a>
                </div>
            </div>
        </div>
    </div>
</div>
